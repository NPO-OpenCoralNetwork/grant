# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Grants Search API
VERSION=1.0.0

# CORS Settings (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501

# External API Settings
JGRANTS_BASE_URL=https://api.jgrants-portal.go.jp/exp/v1/public

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=3600

# Database Settings (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/grants_db

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
